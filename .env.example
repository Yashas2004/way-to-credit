# Copy this file to .env and fill in real values.
# apps/api/src/config/env.ts fails to boot if any required variable is missing.

# --- apps/api ---

# development | test | production
NODE_ENV=development

# Port the Express server listens on
PORT=4000

# Postgres connection string.
# Matches the non-default port exposed by docker-compose.yml (5433).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/way_to_credit

# Redis connection string.
# Matches the non-default port exposed by docker-compose.yml (6380).
REDIS_URL=redis://localhost:6380

# Exact origin allowed to make credentialed CORS requests (the web app's dev URL).
CORS_ORIGIN=http://localhost:5173

# HMAC secret for signing access-token JWTs. Must be at least 32 characters.
# This is a random dev-only sample — generate your own, e.g. `openssl rand -base64 32`.
JWT_SECRET=SupW7ggtzZEYCrSWLVqVIk8WTqdSKCv82dfF4o0mnIc
