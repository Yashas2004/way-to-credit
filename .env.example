# Copy this file to .env and fill in real values.
# apps/api/src/config/env.ts fails to boot if any required variable is missing.

# --- apps/api ---

# development | test | production
NODE_ENV=development

# Port the Express server listens on
PORT=4000

# Postgres connection string.
# Matches the non-default port and throwaway dev role exposed by docker-compose.yml (5433).
DATABASE_URL=postgres://devuser:devpassword_local_only@localhost:5433/way_to_credit

# Redis connection string.
# Matches the non-default port exposed by docker-compose.yml (6380).
REDIS_URL=redis://localhost:6380

# Exact origin allowed to make credentialed CORS requests (the web app's dev URL).
CORS_ORIGIN=http://localhost:5173

# HMAC secret for signing access-token JWTs. Must be at least 32 characters.
# Not a real value — generate your own before use: `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# Optional, local-dev-only. Fakes the clock the Mon-Sat/9-6 IST user access
# window is evaluated against — e.g. to screenshot a user-role screen
# outside real business hours. Only honoured when NODE_ENV=development
# (CLAUDE.md invariant #24); leave unset for normal use.
# FAKE_NOW=2026-01-05T10:00:00.000Z
